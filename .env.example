# ==============================================================================
# MCA Memories 2025–2027 Environment Configuration
# ==============================================================================

# Supabase Project URL and Public Anon Key
# Obtain from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# Service Role Key (Used ONLY by scripts/provision_accounts.ts, NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Initial Provisioning Passwords (Optional, defaults will be used if unset)
INITIAL_ADMIN_PASSWORD=Admin@MCA2025!
INITIAL_STUDENT_PASSWORD=mca2025
