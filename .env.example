# ==============================================================================
# MCA Memories 2025–2027 Environment Configuration (Template)
# ==============================================================================

# Supabase Project URL and Public Anon Key (Required in local .env.local and Vercel)
# Obtain from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Service Role Key (Used ONLY by scripts/provision_accounts.ts, NEVER expose in client bundles or Vercel)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Initial Admin Provisioning (Used ONLY by scripts/provision_accounts.ts)
# INITIAL_ADMIN_EMAIL=admin@mcafarewell
# INITIAL_ADMIN_PASSWORD=your-secure-admin-password

